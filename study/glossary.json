        [
          "liang-2022",
          "§2.5.2"
        ],
        [
          "liang-2023",
          "指标与分类"
        ]
      ],
      "more": "indicators"
    },
    {
      "id": "ecosystem-service",
      "en": "ecosystem services",
      "zh": "生态系统服务",
      "aliases": [
        "ecosystem service",
        "生态系统服务"
      ],
      "definition": "研究中用于表达生态系统与人类获益联系的一组服务概念。程2023讨论的是受访者对这些服务的感知。",
      "caution": "服务感知、生态实测、模型代理指标和社会偏好是不同类型的数据。",
