{
  "schema": "paper.glossary.v3",
  "notice": "教学释义，按相关论文中的用法解释；不是声称作者逐字使用了这些中文定义。",
  "terms": [
    {
      "id": "farming-system",
      "en": "farming system",
      "zh": "农业经营系统",
      "aliases": [
        "farming systems",
        "农业系统",
        "农场系统"
      ],
      "definition": "把经营活动、资源、投入产出及其相互联系作为一个整体研究；边界可以是农场，也可能扩展到家庭或景观。先确认论文选定的边界。",
      "caution": "farming system不等于只描述一种作物的种植技术。",
      "sources": [
        [
          "farmdesign-2012",
          "§2"
        ],
        [
          "ditzler-2019",
          "模型部分"
        ]
      ],
      "more": "whole-farm"
    },
    {
      "id": "cropping-system",
      "en": "cropping system",
      "zh": "种植系统",
      "aliases": [
        "cropping systems",
        "作物种植系统"
      ],
      "definition": "作物组成、时序与管理方式的组合。梁2022比较同一种小麦—玉米双季框架下的不同管理案例，梁2023则设计新的作物序列。",
      "caution": "作物种类相同不代表管理和资源绩效相同。",
      "sources": [
        [
          "liang-2022",
          "§2.1–2.4"
        ],
        [
          "liang-2023",
          "Methods"
        ]
      ],
      "more": "rotation"
    },
    {
      "id": "positive-deviance",
      "en": "positive deviance",
      "zh": "正向偏离",
      "aliases": [
        "positive deviants",
        "positive deviant",
        "正向案例",
        "正向偏离方法"
      ],
      "definition": "寻找现实中表现突出的个体或系统，进一步研究其做法。不同论文可以使用统计筛选、访谈提名等不同识别方式。",
      "caution": "这里不是需要删除的统计异常值；梁2022与Toorop2023的识别程序不同。",
      "sources": [
        [
          "liang-2022",
          "§2.5–2.7"
        ],
        [
          "toorop-2023",
          "Methods"
        ]
      ],
      "more": "positive-deviance"
    },
    {
      "id": "pareto",
      "en": "Pareto dominance",
      "zh": "帕累托支配",
      "aliases": [
        "Pareto-dominance",
        "Pareto",
        "帕累托",
        "帕雷托",
        "支配关系"
      ],
      "definition": "先统一改善方向。若A所有指标都不差于B，且至少一项严格更好，A支配B。",
      "caution": "完全相同的两个点不构成严格支配；指标方向和可行性必须先明确。",
      "sources": [
        [
          "liang-2022",
          "§2.5"
        ],
        [
          "liang-2023",
          "方案筛选"
        ]
      ],
      "more": "pareto"
    },
    {
      "id": "frontier",
      "en": "Pareto front",
      "zh": "帕累托前沿",
      "aliases": [
        "Pareto frontier",
        "Pareto fronts",
        "non-dominated solutions",
        "non-dominated",
        "non dominated",
        "非支配方案",
        "非支配",
        "帕累托前沿"
      ],
      "definition": "在给定比较集合内，不被其他可行方案支配的方案集合。它展示不同指标组合，而不是给出唯一冠军。",
      "caution": "样本前沿、搜索到的近似前沿和被完整枚举的有限可行域前沿，证据范围不同。",
      "sources": [
        [
          "liang-2022",
          "§2.5"
        ],
        [
          "farmsteps-2026",
          "方案枚举与筛选"
        ]
      ],
      "more": "pareto"
    },
    {
      "id": "nondominated-sorting",
      "en": "non-dominated sorting",
      "zh": "非支配排序",
      "aliases": [
        "non dominated sorting",
        "Pareto ranking"
      ],
      "definition": "先取第一前沿，移除后在剩余方案中再取下一前沿，逐层得到排序等级。",
      "caution": "等级不是所有指标的加权总分。",
      "sources": [
        [
          "liang-2022",
          "§2.5"
        ]
      ],
      "more": "pareto"
    },
    {
      "id": "ideal-point",
      "en": "ideal point",
      "zh": "理想点",
      "aliases": [
        "ideal-point",
        "理想点"
      ],
      "definition": "把各指标在参照集合中的最好值组合成比较基准。不同指标的最好值可能来自不同农场，因此该点未必实际可实现。",
      "sources": [
        [
          "liang-2022",
          "§2.5.2"
        ]
      ],
      "more": "ideal-distance"
    },
    {
      "id": "midip",
      "en": "MIDIP",
      "zh": "多指标理想点距离",
      "aliases": [
        "MIDIP"
      ],
      "definition": "梁2022中：计算群组中心到各指标理想值的范围标准化距离，再平方求和并开根号。越小表示整体越靠近理想点。",
      "caution": "不是距离的简单平均；需同时确认标准化范围和理想点来源。",
      "sources": [
        [
          "liang-2022",
          "§2.5.2，原文距离公式"
        ]
      ],
      "more": "ideal-distance"
    },
    {
      "id": "hdip",
      "en": "HDIP",
      "zh": "理想点距离的异质性",
      "aliases": [
        "HDIP"
      ],
      "definition": "梁2022用各指标标准化理想点距离的样本标准差，描述这些距离在指标之间有多不均衡。",
      "caution": "HDIP低只能说明距离较均匀，所有指标都很差也可能得到低值。",
      "sources": [
        [
          "liang-2022",
          "§2.5.2，原文异质性公式"
        ]
      ],
      "more": "ideal-distance"
    },
    {
      "id": "efficiency-score",
      "en": "Pareto efficiency score",
      "zh": "帕累托效率得分",
      "aliases": [
        "Pareto efficiency",
        "帕累托效率得分"
      ],
      "definition": "梁2023逐个检查目标子集，寻找使某方案在所有同大小目标子集中都非支配的最小子集大小k。",
      "caution": "关键是“所有”而非“至少一个”；不要等同综合得分或非支配概率。",
      "sources": [
        [
          "liang-2023",
          "§3.5.2"
        ]
      ],
      "more": "efficiency-score"
    },
    {
      "id": "tradeoff",
      "en": "trade-off",
      "zh": "权衡",
      "aliases": [
        "trade-offs",
        "tradeoff",
        "tradeoffs",
        "权衡关系"
      ],
      "definition": "改善一个关注目标时，另一个目标可能受到不利影响。需区分观测相关、模型预测和优化前沿中的取舍。",
      "caution": "负相关图本身不证明因果权衡，更不证明所有技术条件下都不可同时改善。",
      "sources": [
        [
          "breure-2024",
          "分类框架与讨论"
        ]
      ],
      "more": "causality"
    },
    {
      "id": "synergy",
      "en": "synergy",
      "zh": "协同",
      "aliases": [
        "synergies",
        "协同关系"
      ],
      "definition": "同一变化可能同时改善多个目标的关系。是否成立取决于比较基线、模型假设和系统边界。",
      "sources": [
        [
          "qu-2025",
          "情景与讨论"
        ],
        [
          "breure-2024",
          "分类框架"
        ]
      ],
      "more": "pareto"
    },
    {
      "id": "multiobjective",
      "en": "multi-objective optimization",
      "zh": "多目标优化",
      "aliases": [
        "multiobjective optimization",
        "multi-objective optimisation",
        "多目标优化"
      ],
      "definition": "在给定决策变量和约束内同时评价多个目标，通常得到一组不同取舍的有效方案。",
      "caution": "提出多个目标不意味着它们可以被同时最大化；启发式搜索结果不自动构成全局最优证明。",
      "sources": [
        [
          "farmdesign-2012",
          "§2"
        ],
        [
          "landscape-2018",
          "Methods"
        ]
      ],
      "more": "pareto"
    },
    {
      "id": "decision-variable",
      "en": "decision variable",
      "zh": "决策变量",
      "aliases": [
        "decision variables",
        "决策变量"
      ],
      "definition": "模型允许调整的量，如各作物面积、牲畜数量或地块土地利用类型。",
      "caution": "给定的产量或价格通常是参数，除非模型明确把它们作为可调整决策。",
      "sources": [
        [
          "farmdesign-2012",
          "模型结构"
        ]
      ],
      "more": "whole-farm"
    },
    {
      "id": "constraint",
      "en": "constraint",
      "zh": "约束",
      "aliases": [
        "constraints",
        "资源约束",
        "约束条件"
      ],
      "definition": "方案必须满足的条件，如面积、水、劳动或作物轮作规则。约束决定可行域。",
      "caution": "全年劳动够用不代表收获高峰时段也够用。",
      "sources": [
        [
          "farmsteps-2026",
          "Constraint module"
        ]
      ],
      "more": "rotation"
    },
    {
      "id": "rotation",
      "en": "crop rotation",
      "zh": "作物轮作",
      "aliases": [
        "crop rotations",
        "cropping sequence",
        "crop sequence",
        "crop sequences",
        "作物轮作",
        "作物序列"
      ],
      "definition": "同一土地单元在时间上安排不同作物活动的序列。研究生成方案时，需要播收期、前后衔接、频次和返回间隔规则。",
      "sources": [
        [
          "liang-2023",
          "轮作生成"
        ]
      ],
      "more": "rotation"
    },
    {
      "id": "rotat",
      "en": "ROTAT",
      "zh": "轮作方案生成器",
      "aliases": [
        "ROTAT+",
        "ROTAT"
      ],
      "definition": "根据农学规则生成候选轮作；在梁2023研究流程中，生成后还需计算指标和筛选方案。",
      "caution": "生成候选序列不等于已经完成全农场优化；ROTAT与ROTAT+不可默认视为完全相同版本。",
      "sources": [
        [
          "liang-2023",
          "候选轮作生成"
        ],
        [
          "farmsteps-2026",
          "Crop sequence module"
        ]
      ],
      "more": "rotation"
    },
    {
      "id": "enumeration",
      "en": "enumeration",
      "zh": "枚举",
      "aliases": [
        "enumerating",
        "systematic enumeration",
        "枚举"
      ],
      "definition": "在事先界定的离散选择中逐一生成或检查组合。FarmSTEPS案例采用枚举可行方案，再进行非支配筛选。",
      "caution": "完整性只针对实际定义并遍历的空间；组合数会随地块和候选数迅速增加。",
      "sources": [
        [
          "farmsteps-2026",
          "方案生成与筛选"
        ]
      ],
      "more": "rotation"
    },
    {
      "id": "farmdesign",
      "en": "FarmDESIGN",
      "zh": "全农场生物经济设计模型",
      "aliases": [
        "FarmDESIGN"
      ],
      "definition": "把年度农场资源与生物经济平衡同多目标探索相连；作物、牲畜、饲料、粪肥、劳动和经济相互关联。",
      "caution": "2012基础版为年度静态稳态框架，不能直接当作逐日作物过程模型或所有后续版本。",
      "sources": [
        [
          "farmdesign-2012",
          "§2"
        ]
      ],
      "more": "whole-farm"
    },
    {
      "id": "farmsteps",
      "en": "FarmSTEPS",
      "zh": "农场作物序列时空探索模型",
      "aliases": [
        "FarmSTEPS"
      ],
      "definition": "通过农场配置、土地单元、时间轴、作物序列、指标和约束模块，组织多地块、多时期的作物计划。",
      "caution": "案例中的枚举加筛选，不应称为FarmDESIGN式P-MODE进化搜索。",
      "sources": [
        [
          "farmsteps-2026",
          "模型架构"
        ]
      ],
      "more": "rotation"
    },
    {
      "id": "landscapeimages",
      "en": "LandscapeIMAGES",
      "zh": "空间显式景观多目标探索框架",
      "aliases": [
        "LandscapeIMAGES"
      ],
      "definition": "连接可选土地利用、空间对象和绩效指标，按生成、评价、选择与展示的循环探索景观配置。",
      "caution": "输入GIS并不等于每项指标都包含空间过程；需要逐项检查邻接和配置如何进入计算。",
      "sources": [
        [
          "landscape-2018",
          "§2"
        ]
      ],
      "more": "spatial-design"
    },
    {
      "id": "pmode",
      "en": "P-MODE",
      "zh": "多目标差分进化搜索",
      "aliases": [
        "P-MODE",
        "differential evolution",
        "差分进化"
      ],
      "definition": "通过候选方案的迭代生成、变化、评价和非支配选择探索方案空间。具体操作和参数应以相应模型版本的方法为准。",
      "caution": "它是搜索机制，不是Pareto支配的定义，也不是全局最优证明。",
      "sources": [
        [
          "farmdesign-2012",
          "优化方法"
        ],
        [
          "landscape-2018",
          "优化算法"
        ]
      ],
      "more": "pareto"
    },
    {
      "id": "pca",
      "en": "principal component analysis",
      "zh": "主成分分析",
      "aliases": [
        "principal components analysis",
        "PCA",
        "主成分分析"
      ],
      "definition": "用原变量的线性组合表达主要变异，常用于降维和描述方案差异。结果取决于变量选择和标准化。",
      "caution": "解释方差最多的PC1不是天然的可持续性总分；Q研究中的PCA对象与普通指标矩阵的分析对象也不同。",
      "sources": [
        [
          "liang-2023",
          "分类方法"
        ],
        [
          "cheng-2025",
          "§2.2.4"
        ]
      ],
      "more": "pca-cluster"
    },
    {
      "id": "hca",
      "en": "hierarchical clustering",
      "zh": "层次聚类",
      "aliases": [
        "hierarchical cluster analysis",
        "HCA",
        "层次聚类"
      ],
      "definition": "依照相似性逐步合并或划分对象，形成树状关系，再选择切分层级得到类别。",
      "caution": "距离、连接方法和标准化会改变结果；不同论文的设置不能直接混用。",
      "sources": [
        [
          "liang-2022",
          "§2.5.2"
        ],
        [
          "liang-2023",
          "分类方法"
        ]
      ],
      "more": "pca-cluster"
    },
    {
